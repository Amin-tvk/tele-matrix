# Copy to .env, set the two domains, then: docker compose up -d
# Both domains need DNS records pointing to this server, and ports 80 and 443 must be open.

# Domain of the Peyvand web app
APP_DOMAIN=chat.example.com
# Domain of the Matrix homeserver. User IDs look like @alice:<MATRIX_DOMAIN> and can't change later
MATRIX_DOMAIN=matrix.example.com
# Used for the Let's Encrypt account and as the contact address for browser push services
ADMIN_EMAIL=admin@example.com

# --- Optional ---

# Public IPv4 of this server, for the voice and video call relay. Needed when MATRIX_DOMAIN goes through a CDN
# or proxy; otherwise the relay is reached by MATRIX_DOMAIN
PUBLIC_IP=

# Name shown in the browser tab and the installed app (change it, then: docker compose build web)
APP_TITLE=Peyvand
# Web Push app ID shared by the app and the push gateway. Any reverse-domain string works
PUSH_APP_ID=com.example.peyvand.web
# HTTP proxy for sending notifications, e.g. http://user:pass@proxy.example.com:8080. Needed where Google's push
# service refuses the server's IP (as from Iran); Chrome users get no notifications without it
PUSH_PROXY=
# Domain for the optional Cinny client (see server/caddy/sites/cinny.caddy.example)
CINNY_DOMAIN=
# Ports Caddy listens on. Keep 80 and 443 unless another proxy sits in front
HTTP_PORT=80
HTTPS_PORT=443
# Already running nginx on 80 and 443? Leave Caddy out and let nginx serve Peyvand (docs/nginx.md):
# COMPOSE_FILE=compose.yml:compose.nginx.yml
# Local ports nginx proxies to in that setup
# WEB_LOCAL_PORT=18085
# SYNAPSE_LOCAL_PORT=18008
# SYGNAL_LOCAL_PORT=18083
# KETESA_LOCAL_PORT=18082
# Extra Caddy global options, e.g. "local_certs" for a test setup without public DNS
CADDY_GLOBAL_OPTIONS=

# Optional sticker bot (docs/stickers.md): docker compose --profile stickers up -d
# Password of the bot account (create it first, see the docs)
STICKER_BOT_PASSWORD=
# Token of a Telegram bot from @BotFather; used only to read public sticker packs
TELEGRAM_BOT_TOKEN=
# Proxy for Telegram where it is filtered, e.g. socks5h://xray:10808 with the stickers-proxy profile
TELEGRAM_PROXY=
# Comma separated Matrix IDs whose packs are turned on for everyone
STICKER_ADMINS=
