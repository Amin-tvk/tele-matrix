# Copy to .env and fill in, then run scripts/setup.sh

# Domain of the Peyvand web app
APP_DOMAIN=chat.example.com
# Domain of the Matrix homeserver. User IDs look like @name:<MATRIX_DOMAIN> and can't change later
MATRIX_DOMAIN=matrix.example.com
# Optional: domain for Cinny, a second web client. Leave empty to skip it
CINNY_DOMAIN=
# Contact address sent to browser push services
ADMIN_EMAIL=admin@example.com

# Name shown in the browser tab and the installed app
APP_TITLE=Peyvand
# Web Push app ID shared by the client and Sygnal. Any reverse-domain string works
PUSH_APP_ID=com.example.peyvand.web
