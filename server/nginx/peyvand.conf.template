# Peyvand behind nginx. Generated by scripts/nginx-config.sh from server/nginx/peyvand.conf.template;
# the docker services listen on 127.0.0.1 only (compose.nginx.yml)

# HTTP: certificate challenges, everything else goes to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__ __MATRIX_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# The Peyvand web app
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __APP_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__APP_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_DOMAIN__/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# The homeserver: client and federation API, push gateway, admin UI
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __MATRIX_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__MATRIX_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__MATRIX_DOMAIN__/privkey.pem;

    # Largest file people can send
    client_max_body_size 100M;

    # Federation runs on 443 too, so port 8448 isn't needed
    location = /.well-known/matrix/server {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        return 200 '{"m.server":"__MATRIX_DOMAIN__:443"}';
    }

    location = /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        return 200 '{"m.homeserver":{"base_url":"https://__MATRIX_DOMAIN__"}}';
    }

    # Push gateway (Sygnal)
    location = /_matrix/push/v1/notify {
        proxy_pass http://127.0.0.1:__SYGNAL_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Admin UI (Ketesa)
    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:__KETESA_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Synapse. /sync requests are held open for a while, so no buffering and long timeouts
    location ~ ^(/_matrix|/_synapse/client|/_synapse/admin) {
        proxy_pass http://127.0.0.1:__SYNAPSE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        return 302 https://__APP_DOMAIN__/;
    }
}
