
# Cinny (optional second client)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{CINNY_DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{CINNY_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CINNY_DOMAIN}}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
