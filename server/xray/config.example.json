{
  "log": { "loglevel": "warning" },
  "inbounds": [
    { "tag": "socks", "listen": "0.0.0.0", "port": 10808, "protocol": "socks", "settings": { "udp": false } }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [{
          "address": "YOUR-SERVER-ADDRESS", "port": 443,
          "users": [{ "id": "YOUR-UUID", "encryption": "none" }]
        }]
      },
      "streamSettings": {
        "network": "ws", "security": "tls",
        "tlsSettings": { "serverName": "YOUR-SNI", "fingerprint": "chrome" },
        "wsSettings": { "path": "/YOUR-PATH", "host": "YOUR-SNI" }
      }
    }
  ]
}
